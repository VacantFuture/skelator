---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ContactForm from '../components/ContactForm.astro';
import heroBgSrc from '../assets/images/jake-thacker-I63YZy3S9Ns-unsplash.jpg';
---

<Layout title="High Peaks DSA — Home">
  <Hero
    imageSrc={heroBgSrc.src}
    imageAlt=""
    heading="Democracy, Socialism, and Solidarity"
    description="The High Peaks chapter of the Democratic Socialists of America — building power from the Adirondacks for working people everywhere."
    ctaHref="#latest"
    ctaLabel="Read Our Latest"
  />

  <!-- Latest Articles -->
  <section id="latest" class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <div class="mb-10 flex items-end justify-between">
      <div>
        <h2 class="font-playfair text-heading-3 font-bold text-heading-primary">Latest Articles</h2>
        <p class="mt-2 font-sans text-body text-body-secondary">
          Analysis, reports, and perspectives from the chapter.
        </p>
      </div>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      <!-- Card 1 -->
      <ArticleCard
        title="Why Labor Day Matters for the Working Class"
        excerpt="On Labor Day, we reflect on the victories won by organized labor and the battles still ahead. The fight for fair wages, safe workplaces, and worker power is far from over."
        date="September 2, 2026"
        author="DSA High Peaks"
        imageSrc="/images/labor-day.jpg"
        imageAlt="Workers marching in solidarity"
        href="/articles/why-labor-day-matters"
        tag="Labor"
      />

      <!-- Card 2 -->
      <ArticleCard
        title="Adirondack Housing Crisis: A Socialist Perspective"
        excerpt="With summer residents driving up prices and workers priced out of their own communities, we examine how capitalism fails housing and what socialism offers instead."
        date="August 18, 2026"
        author="DSA High Peaks"
        imageSrc="/images/adirondack-homes.jpg"
        imageAlt="Houses in the Adirondack mountains"
        href="/articles/adirondack-housing-crisis"
        tag="Housing"
      />

      <!-- Card 3 -->
      <ArticleCard
        title="Mutual Aid in the Mountains: Building Community Power"
        excerpt="From food mutual aid to disaster response, DSA High Peaks chapters are showing what solidarity looks like when it matters most."
        date="August 5, 2026"
        author="DSA High Peaks"
        imageSrc="/images/mutual-aid.jpg"
        imageAlt="Volunteers distributing supplies"
        href="/articles/mutual-aid-mountains"
        tag="Mutual Aid"
      />
    </div>

    <div class="mt-10 text-center md:col-span-2">
      <a
        href="/articles"
        class="inline-block rounded-full border-2 border-accent-500 px-8 py-3 font-sans text-body font-bold text-accent-500 transition-colors hover:bg-accent-500 hover:text-neutral-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2"
      >
        View All Articles
      </a>
    </div>
  </section>

  <!-- ActionNetwork Sign-Up Form -->
  <ContactForm
    formSlug="contact-highpeaks-dsa"
    heading="Stay in the Fight"
    description="Join our mailing list to get updates on events, campaigns, and actions in the Adirondacks."
  />
</Layout>

<style is:global>
  .red-100 { color: #fca5a5; }
</style>
